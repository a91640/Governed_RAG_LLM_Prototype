# Copy to .env (never commit .env). All values are optional for the local one-command demo.
RAG_API_URL=                 # empty = run the backend inside Streamlit; http://localhost:8000 = use the FastAPI backend
RAG_API_KEY=                 # shared secret between UI and API (set a long random value when using the API)
RAG_RATE_LIMIT_PER_MIN=30
QDRANT_URL=http://localhost:6333
OLLAMA_HOST=http://localhost:11434
LANGSMITH_API_KEY=           # leave empty to keep tracing off
